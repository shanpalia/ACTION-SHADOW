config_version=5

[application]
config/name="ACTION SHADOW"
config/icon="res://assets/icon.svg"
boot_splash/bg_color=Color(0.02, 0.04, 0.08, 1)
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Original 2.5D offline action game prototype by ShanPalia."

[autoload]
GameState="*res://Scripts/GameState.gd"
MobileControls="*res://Scripts/MobileControls.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.09, 1)

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194313)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
fire={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74),Object(InputEventMouseButton,"button_index":1)]}
